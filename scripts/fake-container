#!/bin/sh
# A stand-in for Apple's `container` CLI, for trying Oopsie's menu without real machines.
# Usage: OOPSIE_CONTAINER="$PWD/scripts/fake-container" swift run
# It shows one running and one stopped machine. Actions succeed but do nothing.
case "$1" in
  list)
    echo '[{"status":{"state":"running","networks":[{"ipv4Address":"192.168.64.3/24"}]},"configuration":{"id":"oopsie-1a2b"}},{"status":{"state":"stopped","networks":[]},"configuration":{"id":"oopsie-77f0"}}]'
    ;;
  exec)
    echo ready
    ;;
esac
exit 0
