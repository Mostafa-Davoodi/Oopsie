#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# A stand-in for Apple's `container` CLI, for trying Oopsie's menu without real machines.
# Usage: OOPSIE_CONTAINER="$PWD/scripts/fake-container" swift run
# It shows three machines: an older Ubuntu one (no distro in its name), a running
# Fedora one and a stopped Arch Linux one. Actions succeed but do nothing.
case "$1" in
  list)
    echo '[{"status":{"state":"running","networks":[{"ipv4Address":"192.168.64.3/24"}]},"configuration":{"id":"oopsie-1a2b"}},{"status":{"state":"running","networks":[{"ipv4Address":"192.168.64.4/24"}]},"configuration":{"id":"oopsie-fedora-3c4d"}},{"status":{"state":"stopped","networks":[]},"configuration":{"id":"oopsie-arch-77f0"}}]'
    ;;
  exec)
    echo ready
    ;;
esac
exit 0
